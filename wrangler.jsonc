{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toki",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toki-local",
      "remote": false
    }
  ]
}
