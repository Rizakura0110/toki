{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toki",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toki-local",
      "remote": false
    }
  ]
}
